[Unit]
Description=stock-unusual-python TDX collector
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=stock-unusual-python
Group=stock-unusual-python
WorkingDirectory=/opt/stock-unusual-python
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/stock-unusual-python.env
EnvironmentFile=-/etc/qmt-realtime/qmt-proxy.env
ExecStart=/opt/stock-unusual-python/.venv3/bin/stock-unusuald --env /etc/stock-unusual-python.env
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/stock-unusual-python
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
